[gd_scene format=3]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_facade"]
albedo_color = Color(0.96, 0.93, 0.89, 1)
roughness = 0.84

[sub_resource type="Shader" id="Shader_lip"]
code = "shader_type spatial;\n\nuniform vec4 base_color : source_color = vec4(0.96, 0.93, 0.89, 1.0);\nuniform vec4 accent_color : source_color = vec4(0.612, 0.812, 0.757, 1.0);\nuniform float half_height = 0.085;\nuniform float accent_thickness = 0.018;\nvarying vec3 local_position;\nvarying vec3 local_normal;\n\nvoid vertex() {\n\tlocal_position = VERTEX;\n\tlocal_normal = NORMAL;\n}\n\nvoid fragment() {\n\tfloat edge = half_height - accent_thickness;\n\tfloat blend = max(fwidth(local_position.y) * 0.5, 0.0001);\n\tfloat accent = max(step(0.5, local_normal.y), smoothstep(edge - blend, edge + blend, local_position.y));\n\tALBEDO = mix(base_color.rgb, accent_color.rgb, accent);\n\tROUGHNESS = 0.78;\n}"

